# Copy to mobile/.env. EXPO_PUBLIC_* values end up inside the app - never
# put secrets here.

# The API. In development (Expo Go) the app always uses the server on this
# computer - npm start at the repo root, port 4444 - found automatically
# (src/platform/config.js), and this is ignored. Release builds use this,
# or the deployed API when it's unset:
# EXPO_PUBLIC_API_URL=https://wearable-psi.vercel.app/api

# The Cloudinary account item photos upload to - the same values as the
# web's VITE_CLOUD_NAME / VITE_UPLOAD_PRESET (public, unsigned preset).
EXPO_PUBLIC_CLOUD_NAME=
EXPO_PUBLIC_UPLOAD_PRESET=
