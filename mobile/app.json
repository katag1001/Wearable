{
  "expo": {
    "name": "LovedWornSeen",
    "slug": "lovedwornseen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.katag1001.lovedwornseen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.katag1001.lovedwornseen"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "LovedWornSeen uses your photos so you can add pictures of your clothes.",
          "cameraPermission": "LovedWornSeen uses your camera so you can photograph your clothes."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LovedWornSeen uses your location to get today's weather, so it can suggest outfits that suit it."
        }
      ]
    ],
    "scheme": "lovedwornseen"
  }
}
